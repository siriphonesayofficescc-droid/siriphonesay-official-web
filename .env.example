# Contact form endpoint (Formspree, Web3Forms, Getform, or your own API).
# The form POSTs JSON: { name, company, email, phone, enquiryType, message }.
# If left empty, the form opens the visitor's email app with the message pre-filled.
VITE_FORM_ENDPOINT=

# Set to "true" only for hosts that cannot rewrite routes to index.html (uses #/ URLs).
VITE_HASH_ROUTER=false

# Optional Supabase backend — enables customer accounts, cloud-saved designs,
# quotation tracking, the shared admin dashboard and 3D-model uploads.
# Supabase → Project settings → API. Run supabase/schema.sql first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
